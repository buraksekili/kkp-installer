# NOTE: If you use direnv, AWS and Route53 credentials are loaded automatically
# from Vault. You only need to set the VAULT_AWS_PATH and VAULT_ROUTE53_PATH
# variables below. The actual credential values are fetched at runtime.

# Configurations related to existing KKP installations where
# KKP within KKP will run (PROVISIONING_METHOD=kkp)
K8C_PROJECT_ID="your-project-id"          # Your KKP project ID
K8C_CLUSTER_ID="your-cluster-id"          # Your KKP cluster ID (can be auto-populated if creating a new cluster)
K8C_CLUSTER_TEMPLATEID="your-template-id" # Template ID for creating a new cluster (optional if SKIP_CLUSTER_CREATION is set)
K8C_CLUSTER_REPLICAS="1"                  # Number of cluster replicas to create
K8C_HOST="https://your-kkp-instance.com"  # KKP API host
K8C_AUTH="your-kkp-token"                 # KKP API token

# Details about the new KKP deployment (both methods)
# For unreleased deploys, set kubermatic.source in config.yaml to override
# the version-based download with a build from a git ref.
KKP_VERSION="2.29.5"                      # KKP version to install
KKP_HOST="your-new-kkp-domain.com"        # Domain for the new KKP instance
KKP_EMAIL="your-email@example.com"        # Email for Let's Encrypt and admin user
ADMIN_PASSWORD="your-admin-password"      # Password for the KKP admin user
WAIT_TIMEOUT_MINUTES="15"                 # Timeout for waiting for nodes to have external IPs

# KubeOne-specific settings (PROVISIONING_METHOD=kubeone)
PROVISIONING_METHOD="kkp"                 # "kkp" or "kubeone"
VAULT_AWS_PATH="your/vault/aws/path"         # Vault path for AWS credentials
VAULT_ROUTE53_PATH="your/vault/route53/path" # Vault path for Route53 credentials
KUBEONE_CLUSTER_NAME="bs-kkp-test"        # Cluster name for KubeOne/Terraform
AWS_REGION="eu-central-1"                 # AWS region
AWS_VPC_ID="default"                      # VPC ID (or "default" for default VPC)
AWS_INSTANCE_TYPE="t3.medium"             # Control plane EC2 instance type
AWS_VOLUME_SIZE="50"                      # Control plane EBS volume size in GB
AWS_WORKER_INSTANCE_TYPE="r5.xlarge"      # Worker node EC2 instance type (needs RAM for KKP)
AWS_WORKER_VOLUME_SIZE="200"              # Worker node EBS volume size in GB
KUBEONE_K8S_VERSION="1.28.0"              # Kubernetes version
SSH_PUBLIC_KEY_FILE="~/.ssh/your_ssh.pub" # SSH public key path
